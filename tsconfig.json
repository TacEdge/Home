{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-narrow/types/**/*.ts",
    ".next-narrow/dev/types/**/*.ts"
  ],
  // Production config: what `next build` type-checks. Test code, test runners
  // and local scripts are excluded because Vercel does not upload them
  // (.vercelignore) — tsconfig.test.json adds them back for `pnpm typecheck`.
  "exclude": [
    "node_modules",
    "prototype",
    ".next",
    ".next-*",
    "out",
    "tests",
    "scripts",
    "playwright.config.ts",
    "vitest.config.mts"
  ]
}
