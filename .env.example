# HOME — environment variables (names only; values live in .env.local, Vercel, or CI secrets).
# Never commit real values. See docs/runbooks/LOCAL-DEV.md.

# Runtime/app credential: the restricted database role used by the HOME
# application (home_app). This is the only database credential supplied to
# Vercel (pooled connection string there; local Docker/Postgres in dev).
DATABASE_URL=postgres://home_app:home_app@localhost:5432/home

# Migration/admin credential: the privileged database role used only for
# migrations and database administration (`pnpm db:migrate`). Never supplied
# to the HOME application or the Vercel runtime; in production it lives only
# in the GitHub `production` environment secret of the same name.
DATABASE_URL_MIGRATE=postgres://home:home@localhost:5432/home

# Better Auth
BETTER_AUTH_SECRET=            # >= 32 random bytes, e.g. `openssl rand -base64 48`
BETTER_AUTH_URL=http://localhost:3000

# Household allowlist: comma-separated emails; the only addresses that can sign in
HOME_ALLOWED_EMAILS=sam@example.test,alex@example.test

# Mail: "provider" (Postmark) or "test" (links captured for tests; refused in production)
HOME_MAIL_TRANSPORT=test
MAIL_API_KEY=
MAIL_FROM=home@auth.example.test

# HMAC key for hashing denied sign-in emails in the audit log (>= 32 bytes)
AUDIT_HASH_SECRET=

# Home time zone
HOME_TIMEZONE=Pacific/Auckland

# Calendar credential key (M4): exactly 32 random bytes, base64, from
# `openssl rand -base64 32`. Different in every environment. Optional: without
# it HOME runs and only refuses calendar connections. Never commit or share it.
HOME_CREDENTIALS_KEY=

# Calendar fingerprint key (M4): another 32 random bytes, base64, from its own
# `openssl rand -base64 32`; never the same value as HOME_CREDENTIALS_KEY.
# Stable: it is not rotated with the credentials key. Different in every
# environment. Optional: without it HOME runs and only refuses calendar
# connections. Never commit or share it.
HOME_FINGERPRINT_KEY=

# Weather (M7): the home location, rounded by HOME to two decimal places
# (elevation to 10 m), and the key for its fingerprint. All optional: without
# them HOME runs with no weather. Locally use only the synthetic public point
# (Wellington's Civic Square, -41.29, 174.78), never a real home. The key is
# its own `openssl rand -base64 32` (at least 32 bytes, base64), never equal
# to any other key here, different in every environment. Production sets
# none of these until the real-data gate opens. Never commit or share them.
HOME_LAT=
HOME_LON=
HOME_ELEVATION=
HOME_WEATHER_LOCATION_KEY=
# Local and CI only: `fake` serves a synthetic forecast instead of calling
# Open-Meteo. Refused on any Vercel deployment and under NODE_ENV=production.
# HOME_TEST_WEATHER=fake

# Kev (M8). Names only; never a value here. HOME_KEV is `off` (default) or
# `on`; Production refuses Kev while the real-data gate is closed, whatever it
# says. Locally use the scripted provider (no key, nothing leaves the
# machine); HOME_TEST_KEV is refused on Vercel and under NODE_ENV=production.
# HOME_KEV_MONTHLY_CAP_NZD: whole NZ dollars, 0 to 300; unset means 100.
# HOME_KEV_PROVIDER_KEY: the provider key, set per environment only at the
# owner's DEPLOY.md §E items; never locally, never in CI, never committed.
# ANTHROPIC_API_KEY and the other ANTHROPIC_* variables are never read.
# (An empty HOME_KEV or HOME_KEV_MONTHLY_CAP_NZD stops the boot: leave them
# commented out unless you set a value.)
# HOME_KEV=on
# HOME_TEST_KEV=scripted
# HOME_KEV_MONTHLY_CAP_NZD=100
HOME_KEV_PROVIDER_KEY=
# CRON_SECRET: the retention cleanup route's secret (POST or GET
# /kev/retention with `Authorization: Bearer <value>`), 16 to 512 printable
# characters; Vercel's cron sends it when set. Unset: the route does nothing
# (404). No schedule is configured until the owner's G18 decision.
CRON_SECRET=

# Vercel only (VERCEL_ENV is set by Vercel). Preview deployments must set the
# production database host so they can refuse it; production may set it to
# assert its own. Leave unset locally.
# HOME_PRODUCTION_DB_HOST=
